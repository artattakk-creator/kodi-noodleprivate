<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.gsmedia" name="GS Media Kodi Repository" version="1.5.0" provider-name="GS Media">
  <extension point="xbmc.addon.repository">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/artattakk-creator/kodi-noodleprivate/main/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/artattakk-creator/kodi-noodleprivate/main/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/artattakk-creator/kodi-noodleprivate/main/</datadir>
      <hashes>false</hashes>
    </dir>
    <!-- Original Cumination add-on repository; Kodi resolves and updates it upstream. -->
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/dobbelina/repository.dobbelina/master/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/dobbelina/repository.dobbelina/master/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/dobbelina/repository.dobbelina/master/</datadir>
    </dir>
    <!-- Dependencies, including ResolveURL provider packages, as listed by upstream. -->
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/Gujal00/smrzips/master/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/Gujal00/smrzips/master/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/Gujal00/smrzips/master/zips/</datadir>
    </dir>
    <!-- Original xVAULT add-on and xVAULT Repository: original upstream GitHub, HTTPS. -->
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/mojomedia1812/xVAULT/main/docs/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/mojomedia1812/xVAULT/main/docs/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/mojomedia1812/xVAULT/main/docs/</datadir>
      <hashes>false</hashes>
    </dir>
    <!-- AchillesPunks Titan BINGIE MOD: Kodi 20 Nexus, unmodified upstream index -->
    <dir minversion="20.0.0" maxversion="20.9.0">
      <info compressed="false">https://raw.githubusercontent.com/AchillesPunks/repository.titan.bingie.mod/master/nexus/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/AchillesPunks/repository.titan.bingie.mod/master/nexus/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/AchillesPunks/repository.titan.bingie.mod/master/nexus/</datadir>
      <hashes>false</hashes>
    </dir>
    <!-- Omega upstream checksum is stale; use source XML as change marker -->
    <dir minversion="20.9.1">
      <info compressed="false">https://raw.githubusercontent.com/AchillesPunks/repository.titan.bingie.mod/master/omega/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/AchillesPunks/repository.titan.bingie.mod/master/omega/addons.xml</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/AchillesPunks/repository.titan.bingie.mod/master/omega/</datadir>
      <hashes>false</hashes>
    </dir>
    <!-- Upstream peno64: EZ Maintenance+ and other utilities. Kodi dependencies resolve normally. -->
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/peno64/repository.peno64/master/repo/zips/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/peno64/repository.peno64/master/repo/zips/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/peno64/repository.peno64/master/repo/zips/</datadir>
      <hashes>false</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="de_DE">Zentrales GS Media Kodi Repository (einzige Update-Quelle fuer Noodle Private)</summary>
    <description lang="de_DE">Einziges GS Media Repository fuer Noodle Private, Cumination, SMR, xVAULT Titan BINGIE MOD und EZ Maintenance+. Das fruehere Noodle Private Repository ist eingestellt.</description>
    <summary lang="en_GB">GS Media's Kodi add-on repository</summary>
    <description lang="en_GB">Single GS Media update source for Noodle Private, plus upstream Cumination, SMR, xVAULT Titan BINGIE MOD and EZ Maintenance+ catalogs.</description>
    <disclaimer lang="de_DE">Eigenständiges Drittanbieter-Repository. Externe Projekte (Cumination, SMR, xVAULT) werden unverändert von ihren Urhebern gepflegt; xVAULT-Support nur ueber das offizielle Repository. Nicht mit Team Kodi verbunden.</disclaimer>
    <platform>all</platform>
    <license>MIT</license>
    <assets><icon>icon.png</icon><fanart>fanart.png</fanart></assets>
  </extension>
</addon>