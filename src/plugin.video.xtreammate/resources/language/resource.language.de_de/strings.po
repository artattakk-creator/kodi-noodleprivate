msgstr "Sofortaufnahmen / Stoppen / Abspielen"

msgctxt "#34009"
msgid "Finish recording safely now? The player remains unchanged."
msgstr "Aufnahme jetzt sicher abschließen? Der Player bleibt unverändert."

msgctxt "#34010"
msgid "Play completed local recording?"
msgstr "Fertige lokale Aufnahme abspielen?"

msgctxt "#34011"
msgid "Native Direct-TS manual recording (test candidate): Start/Stop without an FFmpeg app, timers or media manager."
msgstr "Native Direct-TS-Sofortaufnahme (Testkandidat): Start/Stop ohne FFmpeg-App, Timer oder Medienmanager."

msgctxt "#34012"
msgid "Recording action unavailable or cancelled. Check storage and recording status."
msgstr "Aufnahmeaktion nicht möglich oder abgebrochen. Speicher und Aufnahmestatus prüfen."

msgctxt "#34013"
