<?xml version="1.0" encoding="UTF-8"?>
<settings>
  <category label="32270">
    <setting id="new_portal_name"    type="text" label="32271" default="My IPTV"/>
    <setting id="new_portal_type"    type="enum" label="32272" default="0"
             values="M3U URL|M3U Datei|Xtream Codes|STB / Stalker"/>
    <!-- M3U URL (type 0) und M3U Datei (type 1) -->
    <setting id="new_portal_m3u_url" type="text" label="32274" default=""
             visible="eq(-1,0)|eq(-1,1)"/>
    <!-- Xtream Codes (type 2) -->
    <setting id="new_portal_xc_host" type="text" label="32275" default=""
             visible="eq(-2,2)"/>
    <setting id="new_portal_xc_user" type="text" label="32276" default=""
             visible="eq(-3,2)"/>
    <setting id="new_portal_xc_pass" type="text" label="32277" default="" option="hidden"
             visible="eq(-4,2)"/>
    <!-- STB / Stalker (type 3) -->
    <setting id="new_portal_stb_url" type="text" label="32278" default=""
             visible="eq(-5,3)"/>
    <setting id="new_portal_stb_mac" type="text" label="32279" default="00:1A:79:00:00:00"
             visible="eq(-6,3)"/>
    <!-- EPG -->
    <setting id="new_portal_epg_url"  type="text" label="32280" default=""/>
    <setting id="new_portal_epg_show" type="bool" label="32281" default="true"/>
    <!-- Enabled -->
    <setting id="new_portal_enabled"  type="bool" label="32091" default="true"/>
    <!-- Add button -->
    <setting id="new_portal_add" type="action" label="32282"
             action="RunPlugin(plugin://plugin.video.xtreammate/?action=add_portal_from_settings)"/>
  </category>
  <category label="32200">
    <setting id="open_portal_manager" type="action"
             label="32201"
             action="RunPlugin(plugin://plugin.video.xtreammate/?action=portal_manager)"/>
    <setting id="startup_xtream" type="action"
             label="XtreamMate: Startsender / Startgruppe"
             action="RunPlugin(plugin://plugin.video.xtreammate/?action=startup_settings)"/>
    <setting id="remote_xtream" type="action"
             label="XtreamMate: Links / OK Fernbedienung aktivieren"
             action="RunPlugin(plugin://plugin.video.xtreammate/?action=remote_setup)"/>
    <setting id="manage_xtream_groups" type="action"
             label="XtreamMate: Live-TV-, Film- und Seriengruppen verwalten"
             action="RunPlugin(plugin://plugin.video.xtreammate/?action=groups_manager)"/>
    <setting id="portal_count_info" type="lsep" label=""/>
  </category>
  <category label="32210">
    <setting id="lang_priority" type="text" label="32211" default=""/>
    <setting id="lang_filter_info" type="lsep" label="32212"/>
    <setting id="lang_match_name"  type="bool" label="32213" default="true"/>
    <setting id="lang_match_group" type="bool" label="32214" default="true"/>
  </category>
  <category label="32220">
    <setting id="player_default" type="enum" label="32221"
             values="32222" default="0"/>
    <setting id="user_agent" type="text" label="32223"
             default="Mozilla/5.0 (Linux; Android 11; TV) AppleWebKit/537.36"/>
    <setting id="http_timeout"  type="slider" label="32224"
             default="15" range="5,1,60"/>
    <setting id="max_retries"   type="slider" label="32225"
             default="3"  range="0,1,10"/>
    <setting id="use_inputstream_hls"  type="bool" label="32226" default="true"/>
    <setting id="use_inputstream_dash" type="bool" label="32227" default="true"/>
    <setting id="stream_quality" type="enum" label="32228"
             values="32229" default="0"/>
  </category>
  <category label="32230">
    <setting id="epg_sources_manager" type="action"
             label="XtreamMate: EPG-Quellen und Senderzuordnung"
             action="RunPlugin(plugin://plugin.video.xtreammate/?action=epg_sources)"/>
    <setting id="epg_enabled"         type="bool"   label="32236" default="true"/>
    <setting id="epg_lines"           type="slider" label="32237" default="3"    range="0,1,5"/>
    <setting id="epg_auto_refresh"    type="bool"   label="32231" default="true"/>
    <setting id="epg_refresh_hours"   type="slider" label="32232" default="12" range="1,1,48"/>
    <setting id="epg_hours_ahead"     type="slider" label="32233" default="12" range="2,2,24"/>
    <setting id="epg_hours_back"      type="slider" label="32234" default="3"  range="0,1,72"/>
    <setting id="epg_show_thumbnails" type="bool"   label="32235" default="true"/>
  </category>
  <category label="32240">
    <setting id="show_channel_logos" type="bool"   label="32241" default="true"/>
    <setting id="items_per_page"     type="slider" label="32242" default="50" range="20,10,200"/>
    <setting id="sort_channels"      type="enum"   label="32243" values="32244" default="0"/>
    <setting id="sort_groups"        type="enum"   label="32245" values="32246" default="0"/>
    <setting id="view_mode"          type="enum"   label="32247" values="32248" default="0"/>
  </category>
  <category label="32250">
    <setting id="cache_playlists" type="bool"   label="32251" default="true"/>
    <setting id="cache_epg"       type="bool"   label="32252" default="true"/>
    <setting id="cache_dir"       type="text"   label="32253" default=""/>
    <setting id="clear_cache"     type="action" label="32254"
             action="RunPlugin(plugin://plugin.video.xtreammate/?action=clear_cache)"/>
    <setting id="favourites_file"   type="text" label="32255" default=""/>
    <!-- Kodi folder picker: press OK to save the path in add-on settings. -->
    <setting id="recordings_folder" type="folder" label="32256"
             source="auto" option="writeable" default=""/>
  </category>
  <category label="32290">
    <setting id="dropbox_token"       type="text" label="32299" default="" option="hidden"/>
    <setting id="dropbox_backup_path" type="text" label="32300" default="/portals_backup.json"/>
  </category>
  <category label="32260">
    <setting id="proxy_url"     type="text" label="32261" default=""/>
    <setting id="proxy_user"    type="text" label="32262" default=""/>
    <setting id="proxy_pass"    type="text" label="32263" default="" option="hidden"/>
    <setting id="ssl_verify"    type="bool" label="32264" default="true"/>
    <setting id="debug_logging" type="bool" label="32265" default="false"/>
    <setting id="catchup_format" type="text" label="32266"
             default="{url}?utc={utc}&amp;lutc={lutc}"/>
  </category>
</settings>
