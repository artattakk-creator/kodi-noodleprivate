<?xml version='1.0' encoding='utf-8'?>
<includes>
  <include name="XCMate48.LiveHero">
    <param name="liveid" />
    <param name="existing_live_url" />
    <definition>
      <control type="group">
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>1280</width>
          <height>720</height>
          <texture>special://home/addons/plugin.video.xtreammate/resources/media/programme46/panel.png</texture>
        </control>
        <control type="image">
          <left>44</left>
          <top>84</top>
          <width>760</width>
          <height>428</height>
          <texture>$INFO[Container($PARAM[liveid]).ListItem.Property(XCMate.ProgrammeImage46)]</texture>
          <aspectratio>keep</aspectratio>
        </control>
        <control type="image">
          <left>58</left>
          <top>98</top>
          <width>110</width>
          <height>66</height>
          <texture>special://home/addons/plugin.video.xtreammate/resources/media/programme46/logo-back.png</texture>
        </control>
        <control type="image">
          <left>66</left>
          <top>106</top>
          <width>94</width>
          <height>50</height>
          <texture>$INFO[Container($PARAM[liveid]).ListItem.Property(XCMate.ProgrammeLogo46)]</texture>
          <aspectratio>keep</aspectratio>
        </control>
        <control type="label">
          <left>838</left>
          <top>84</top>
          <width>398</width>
          <height>42</height>
          <label>$INFO[Container($PARAM[liveid]).ListItem.Property(XCMate.ProgrammeChannel46)]</label>
          <font>Reg18</font>
          <textcolor>FFFFFFFF</textcolor>
        </control>
        <control type="textbox">
          <left>838</left>
          <top>136</top>
          <width>398</width>
          <height>92</height>
          <label>$INFO[Container($PARAM[liveid]).ListItem.Property(XCMate.ProgrammeTitle46)]</label>
          <font>Bold22</font>
          <textcolor>FFFFFFFF</textcolor>
        </control>
        <control type="label">
          <left>838</left>
          <top>240</top>
          <width>398</width>
          <height>32</height>
          <label>$INFO[Container($PARAM[liveid]).ListItem.Property(XCMate.ProgrammeTimes46)]</label>
          <font>Reg18</font>
          <textcolor>FFFFFFFF</textcolor>
        </control>
        <control type="textbox">
          <left>838</left>
          <top>282</top>
          <width>398</width>
          <height>165</height>
          <label>$INFO[Container($PARAM[liveid]).ListItem.Property(XCMate.ProgrammeDescription46)]</label>
          <font>Reg18</font>
          <textcolor>FFFFFFFF</textcolor>
        </control>
        <control type="label">
          <left>838</left>
          <top>464</top>
          <width>398</width>
          <height>46</height>
          <label>Danach: $INFO[Container($PARAM[liveid]).ListItem.Property(XCMate.ProgrammeNextTimes48)] · $INFO[Container($PARAM[liveid]).ListItem.Property(XCMate.ProgrammeNext46)]</label>
          <font>Reg18</font>
          <textcolor>FFFFFFFF</textcolor>
        </control>
        <control type="progress">
          <left>44</left>
          <top>524</top>
          <width>1192</width>
          <height>8</height>
          <info>Container($PARAM[liveid]).ListItem.Property(XCMate.ProgrammePercent46)</info>
          <texturebg>special://home/addons/plugin.video.xtreammate/resources/media/programme46/track.png</texturebg>
          <midtexture>special://home/addons/plugin.video.xtreammate/resources/media/programme46/progress.png</midtexture>
        </control>
        <control type="panel" id="$PARAM[liveid]">
          <left>44</left>
          <top>560</top>
          <width>1192</width>
          <height>110</height>
          <orientation>horizontal</orientation>
          <onup>$PARAM[liveid]</onup>
          <ondown>$PARAM[liveid]</ondown>
          <onleft>$PARAM[liveid]</onleft>
          <onright>$PARAM[liveid]</onright>
          <itemlayout width="142" height="104">
            <control type="image">
              <left>2</left>
              <top>2</top>
              <width>136</width>
              <height>100</height>
              <texture>special://home/addons/plugin.video.xtreammate/resources/media/programme46/logo-back.png</texture>
            </control>
            <control type="image">
              <left>37</left>
              <top>10</top>
              <width>68</width>
              <height>40</height>
              <texture>$INFO[ListItem.Property(XCMate.ProgrammeLogo46)]</texture>
              <aspectratio>keep</aspectratio>
            </control>
            <control type="label">
              <left>6</left>
              <top>57</top>
              <width>130</width>
              <height>35</height>
              <label>$INFO[ListItem.Label]</label>
              <font>Reg18</font>
              <textcolor>FFFFFFFF</textcolor>
              <align>center</align>
            </control>
          </itemlayout>
          <focusedlayout width="142" height="104">
            <control type="image">
              <left>2</left>
              <top>2</top>
              <width>136</width>
              <height>100</height>
              <texture>special://home/addons/plugin.video.xtreammate/resources/media/programme46/progress.png</texture>
            </control>
            <control type="image">
              <left>37</left>
              <top>10</top>
              <width>68</width>
              <height>40</height>
              <texture>$INFO[ListItem.Property(XCMate.ProgrammeLogo46)]</texture>
              <aspectratio>keep</aspectratio>
            </control>
            <control type="label">
              <left>6</left>
              <top>57</top>
              <width>130</width>
              <height>35</height>
              <label>$INFO[ListItem.Label]</label>
              <font>Reg18</font>
              <textcolor>FFFFFFFF</textcolor>
              <align>center</align>
            </control>
          </focusedlayout>
          <content target="videos">$PARAM[existing_live_url]</content>
        </control>
      </control>
    </definition>
  </include>
</includes>