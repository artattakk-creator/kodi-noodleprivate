  "outer": [
    "Expr(value=Constant(value='XCMate remote-control TV navigation, displayed over active Xtream live TV.\\n\\nFirst OK: compact programme info. Second OK/Down: player controls.\\nLeft opens indexed channels; Left again opens groups. Back returns one level.\\nUp/Down zap only in full-screen mode. Stop releases playback and dialog.\\n\\nKodi handles native list movement before Python callbacks. Bridge commands move\\nthe list explicitly; native events must not move it a second time. No network\\nrequests are made in input callbacks.\\n'))",
    "Import(names=[alias(name='json')])",
    "Import(names=[alias(name='math')])",
    "Import(names=[alias(name='os')])",
    "Import(names=[alias(name='time')])",
    "Import(names=[alias(name='uuid')])",
    "Import(names=[alias(name='xbmc')])",
    "Import(names=[alias(name='xbmcgui')])",
    "ImportFrom(module='utils', names=[alias(name='info'), alias(name='warn')], level=0)",
    "Assign(targets=[Name(id='SESSION_KEY', ctx=Store())], value=Constant(value='XtreamMate.LiveSession'))",
    "Assign(targets=[Name(id='ACTION_LEFT', ctx=Store())], value=Constant(value=1))",
    "Assign(targets=[Name(id='ACTION_RIGHT', ctx=Store())], value=Constant(value=2))",
    "Assign(targets=[Name(id='ACTION_UP', ctx=Store())], value=Constant(value=3))",
    "Assign(targets=[Name(id='ACTION_DOWN', ctx=Store())], value=Constant(value=4))",
    "Assign(targets=[Name(id='ACTION_PAGE_UP', ctx=Store())], value=Constant(value=5))",
    "Assign(targets=[Name(id='ACTION_PAGE_DOWN', ctx=Store())], value=Constant(value=6))",
    "Assign(targets=[Name(id='ACTION_SELECT', ctx=Store())], value=Constant(value=7))",
    "Assign(targets=[Name(id='ACTION_PREVIOUS_MENU', ctx=Store())], value=Constant(value=10))",
    "Assign(targets=[Name(id='ACTION_STOP', ctx=Store())], value=Constant(value=13))",
    "Assign(targets=[Name(id='ACTION_PAUSE', ctx=Store())], value=Constant(value=12))",
    "Assign(targets=[Name(id='ACTION_NAV_BACK', ctx=Store())], value=Constant(value=92))",
    "Assign(targets=[Name(id='ACTION_CONTEXT_MENU', ctx=Store())], value=Constant(value=117))",
    "Assign(targets=[Name(id='ACTION_PARENT_DIR', ctx=Store())], value=Constant(value=9))",
    "Assign(targets=[Name(id='BACK_ACTIONS', ctx=Store())], value=Tuple(elts=[Name(id='ACTION_PREVIOUS_MENU', ctx=Load()), Name(id='ACTION_NAV_BACK', ctx=Load()), Name(id='ACTION_PARENT_DIR', ctx=Load())], ctx=Load()))",
