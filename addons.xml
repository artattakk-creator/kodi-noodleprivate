<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.noodleprivate" name="Noodle Private" version="0.3.0" provider-name="Private Kodi Project">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="de_DE">Privates Video-Plugin mit BINGIE-MOD-Widgets</summary>
    <description lang="de_DE">Videolisten, Suche, Filter, anbieterübergreifende Favoritenlisten, Cumination-Quellen und Wiedergabe von NoodleMagazine. Private Testversion; keine Verbindung zum Website-Betreiber.</description>
    <summary lang="en_GB">Private video plugin with Kodi widgets</summary>
    <description lang="en_GB">Browse, search, save cross-provider collections and play supported sources with Cumination. Independent personal test build.</description>
    <disclaimer lang="de_DE">Für volljährige Nutzer. Keine Gewähr für Verfügbarkeit, Zugriff oder Nutzungsrechte externer Inhalte. Kein Umgehen von Zugriffssperren.</disclaimer>
    <platform>all</platform>
    <license>MIT</license>
    <assets><icon>resources/icon.png</icon><fanart>resources/fanart.png</fanart></assets>
  </extension>
</addon>
<addon id="repository.gsmedia" name="GS Media Kodi Repository" version="1.1.0" provider-name="GS Media">
  <extension point="xbmc.addon.repository">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/artattakk-creator/kodi-noodleprivate/main/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/artattakk-creator/kodi-noodleprivate/main/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/artattakk-creator/kodi-noodleprivate/main/</datadir>
      <hashes>false</hashes>
    </dir>
    <!-- Original Cumination add-on repository; Kodi resolves and updates it upstream. -->
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/dobbelina/repository.dobbelina/master/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/dobbelina/repository.dobbelina/master/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/dobbelina/repository.dobbelina/master/</datadir>
    </dir>
    <!-- Dependencies, including ResolveURL provider packages, as listed by upstream. -->
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/Gujal00/smrzips/master/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/Gujal00/smrzips/master/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/Gujal00/smrzips/master/zips/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="de_DE">Zentrale Add-on-Verwaltung von GS Media</summary>
    <description lang="de_DE">GS Media Kodi-Erweiterungen sowie den separat gepflegten Cumination-Katalog installieren und aktualisieren. Noodle Private bleibt eigenständig.</description>
    <summary lang="en_GB">GS Media's Kodi add-on repository</summary>
    <description lang="en_GB">Install and update GS Media add-ons, including Noodle Private, plus upstream Cumination and resolver dependencies.</description>
    <disclaimer lang="de_DE">Eigenständiges Drittanbieter-Repository; Cumination wird extern von seinen Entwicklern gepflegt. Nicht mit Team Kodi verbunden.</disclaimer>
    <platform>all</platform>
    <license>MIT</license>
    <assets><icon>icon.png</icon><fanart>fanart.png</fanart></assets>
  </extension>
</addon>
<addon id="repository.noodleprivate" name="Noodle Private Repository" version="0.1.0" provider-name="GS Media">
  <extension point="xbmc.addon.repository">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/artattakk-creator/kodi-noodleprivate/main/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/artattakk-creator/kodi-noodleprivate/main/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/artattakk-creator/kodi-noodleprivate/main/</datadir>
      <hashes>false</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="de_DE">Kodi-Repository für Noodle Private</summary>
    <description lang="de_DE">Enthält die private Entwicklungsreihe von Noodle Private. Nur Add-on-Code, keine Favoriten oder lokalen Daten.</description>
    <summary lang="en_GB">Kodi repository for Noodle Private</summary>
    <description lang="en_GB">Install and update the Noodle Private Kodi video add-on. Local preferences remain local.</description>
    <platform>all</platform>
    <license>MIT</license>
    <assets><icon>icon.png</icon><fanart>fanart.png</fanart></assets>
  </extension>
</addon>
</addons>
